<?xml version="1.0" encoding="utf-8"?>
<mdscript name="CasinoStationCues" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cues>
    <!--
      Global State Setup on Game Start / Load
    -->
    <cue name="Init_Casino_State">
      <conditions>
        <check_any>
          <event_cue_signalled cue="md.Setup.GameStart"/>
          <event_game_loaded/>
        </check_any>
      </conditions>
      <actions>
        <do_if value="not player.entity.$casino_data?">
          <set_value name="player.entity.$casino_data" exact="table[]"/>
          <set_value name="player.entity.$casino_data.$CurrentBet" exact="5000"/>
          <set_value name="player.entity.$casino_data.$Reel1" exact="'[ PROFIT! ]'"/>
          <set_value name="player.entity.$casino_data.$Reel2" exact="'[ PROFIT! ]'"/>
          <set_value name="player.entity.$casino_data.$Reel3" exact="'[ PROFIT! ]'"/>
          <set_value name="player.entity.$casino_data.$ResultBanner" exact="'Match 3 symbols for profitsss!'"/>
          <set_value name="player.entity.$casino_data.$TotalSpins" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWagered" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWon" exact="0"/>
          <set_value name="player.entity.$casino_data.$NetProfit" exact="0"/>
          <set_value name="player.entity.$casino_data.$JackpotsHit" exact="0"/>
          <set_value name="player.entity.$casino_data.$DemoMode" exact="0"/>
        </do_if>
      </actions>
    </cue>

    <!--
      Register Menus in SirNukes Options Menu (Fallback / Config Access)
    -->
    <cue name="Register_Options_Menu" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled cue="md.Simple_Menu_API.Reloaded"/>
      </conditions>
      <actions>
        <!-- Register Slots in Options Menu -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Register_Options_Menu"
          param="table[
            $id       = 'x4_casino_slots_menu',
            $columns  = 3,
            $title    = 'Teladi Profit Spinner',
            $onOpen   = Build_Slots_Menu,
          ]"/>

        <!-- Register Casino Lobby in Options Menu -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Register_Options_Menu"
          param="table[
            $id       = 'x4_casino_lobby_menu',
            $columns  = 4,
            $title    = 'Station Casino &amp; Gaming Lobby',
            $onOpen   = Build_Lobby_Menu,
          ]"/>
      </actions>
    </cue>

    <!--
      ========================================================================
      2. Dynamic Room Discovery & Fallback Croupier Lifecycle Management
      ========================================================================
    -->
    <cue name="On_Player_Room_Changed" instantiate="true" namespace="this">
      <conditions>
        <check_any>
          <event_object_changed_room object="player.entity"/>
          <event_game_loaded/>
        </check_any>
        <check_value value="player.station.exists and player.room.exists"/>
      </conditions>
      <actions>
        <set_value name="$isCasinoRoom" exact="false"/>
        <!-- Tag & RoomType Dynamic Discovery -->
        <do_if value="player.room.hastag.tag.casino or player.room.hastag.tag.gambling">
          <set_value name="$isCasinoRoom" exact="true"/>
        </do_if>
        <do_else>
          <find_npc_slot name="$DealerSlots" tags="tag.roulette_dealer" object="player.room" multiple="true"/>
          <do_if value="$DealerSlots.count gt 0">
            <set_value name="$isCasinoRoom" exact="true"/>
          </do_if>
          <do_elseif value="player.room.roomtype == roomtype.bar and player.station.welfaremodules.count gt 0">
            <set_value name="$isCasinoRoom" exact="true"/>
          </do_elseif>
          <do_elseif value="player.room.macro.ismacro.[macro.room_gen_casino_01_macro, macro.room_gen_bar_01_macro, macro.room_gen_gamblingden_01_macro]">
            <set_value name="$isCasinoRoom" exact="true"/>
          </do_elseif>
        </do_else>

        <!-- Tier 3: Fallback Croupier Spawner (Only if room lacks pre-baked roulette dealer) -->
        <do_if value="$isCasinoRoom">
          <find_npc_slot name="$DealerSlots" tags="tag.roulette_dealer" object="player.room" multiple="true"/>
          <do_if value="$DealerSlots.count == 0 and (not player.room.$casino_host? or not player.room.$casino_host.isalive)">
            <create_cue_actor cue="this" name="$host">
              <select race="player.station.owner.primaryrace"/>
              <owner exact="player.station.owner"/>
            </create_cue_actor>
            <set_value name="$host.knownname" exact="'Casino Croupier'"/>
            <add_actor_to_room actor="$host" room="player.room"/>
            <set_entity_overrides entity="$host" icon="'pilot'" title="'Casino Croupier'"/>
            <set_entity_role entity="$host" role="entityrole.service"/>
            <set_entity_traits entity="$host" customhandler="true"/>
            <set_value name="$host.$is_casino_croupier" exact="true"/>
            <set_value name="player.room.$casino_host" exact="$host"/>
          </do_if>
        </do_if>
      </actions>
    </cue>

    <!-- Clean despawn when player leaves room -->
    <cue name="On_Player_Left_Room" instantiate="true" namespace="this">
      <conditions>
        <event_object_changed_room object="player.entity"/>
        <check_value value="event.param.exists and event.param.$casino_host?"/>
      </conditions>
      <actions>
        <do_if value="event.param.$casino_host.isalive">
          <destroy_object object="event.param.$casino_host"/>
        </do_if>
        <remove_value name="event.param.$casino_host"/>
      </actions>
    </cue>

    <!--
      ========================================================================
      3. Tier 1 & Tier 3: Table Dealer / Croupier Zero-Click Direct Bypass
      ========================================================================
    -->
    <cue name="On_Dealer_Conversation_Started" instantiate="true" namespace="this">
      <conditions>
        <check_any>
          <event_conversation_started/>
          <event_conversation_returned_to_section/>
        </check_any>
        <check_value value="player.station.exists and event.object.isclass.npc and (
          event.object.$roulette_dealer_slot? or
          event.object.$is_casino_croupier? or
          event.object.name == '{20208,20801}' or
          event.object.name == '{20208,20802}' or
          event.object.name == 'Casino Croupier'
        )"/>
      </conditions>
      <actions>
        <!-- Immediate Close: Bypasses 3D Dialogue Overlay Instantly (Frame 0) -->
        <set_value name="player.entity.$casino_pending_open" exact="'lobby'"/>
        <close_conversation/>
      </actions>
    </cue>

    <!--
      ========================================================================
      4. Tier 2: Station Bartender Dialogue Hook (Strictly Bartenders Only)
      ========================================================================
    -->
    <cue name="On_Bartender_Conversation_Started" instantiate="true" namespace="this">
      <conditions>
        <check_any>
          <event_conversation_started/>
          <event_conversation_returned_to_section/>
        </check_any>
        <check_value value="player.station.exists and event.object.isclass.npc and (
          event.object.type == entitytype.bartender or
          event.object.role == entityrole.bartender
        )"/>
      </conditions>
      <actions>
        <add_player_choice
          text="'[Casino] Station Game Lobby'"
          section="'x4_casino_open_lobby'"
          position="bottom_right"
          comment="Diegetic bar interaction choice"/>
      </actions>
    </cue>

    <cue name="On_Bartender_Next_Section" instantiate="true" namespace="this">
      <conditions>
        <event_conversation_next_section/>
        <check_value value="event.param == 'x4_casino_open_lobby'"/>
      </conditions>
      <actions>
        <set_value name="player.entity.$casino_pending_open" exact="'lobby'"/>
        <close_conversation/>
      </actions>
    </cue>

    <!--
      ========================================================================
      5. Modal Screen Dispatcher
      ========================================================================
    -->
    <cue name="On_Conversation_Finished_Open" instantiate="true" namespace="this">
      <conditions>
        <event_conversation_finished/>
        <check_value value="player.entity.$casino_pending_open?"/>
      </conditions>
      <actions>
        <set_value name="$targetScreen" exact="player.entity.$casino_pending_open"/>
        <remove_value name="player.entity.$casino_pending_open"/>
        <do_if value="$targetScreen == 'slots'">
          <signal_cue_instantly cue="Open_Slots_Direct"/>
        </do_if>
        <do_elseif value="$targetScreen == 'lobby'">
          <signal_cue_instantly cue="Open_Lobby_Direct"/>
        </do_elseif>
      </actions>
    </cue>

    <!--
      Direct Modal Launcher: Open Casino Game Lobby
    -->
    <cue name="Open_Lobby_Direct" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Ensure player data table exists -->
        <do_if value="not player.entity.$casino_data?">
          <set_value name="player.entity.$casino_data" exact="table[]"/>
          <set_value name="player.entity.$casino_data.$CurrentBet" exact="5000"/>
          <set_value name="player.entity.$casino_data.$Reel1" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel2" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel3" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$ResultBanner" exact="'Welcome to the Station Casino!'"/>
          <set_value name="player.entity.$casino_data.$TotalSpins" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWagered" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWon" exact="0"/>
          <set_value name="player.entity.$casino_data.$NetProfit" exact="0"/>
          <set_value name="player.entity.$casino_data.$JackpotsHit" exact="0"/>
          <set_value name="player.entity.$casino_data.$DemoMode" exact="0"/>
        </do_if>

        <!-- Track Station House Ledger if docked at a station -->
        <do_if value="player.station.exists">
          <do_if value="not player.station.$casino_ledger?">
            <set_value name="player.station.$casino_ledger" exact="table[]"/>
            <set_value name="player.station.$casino_ledger.$HouseGrossRevenue" exact="0"/>
            <set_value name="player.station.$casino_ledger.$HousePayoutsTotal" exact="0"/>
            <set_value name="player.station.$casino_ledger.$HouseNetIncome" exact="0"/>
            <set_value name="player.station.$casino_ledger.$VisitCount" exact="0"/>
            <set_value name="player.station.$casino_ledger.$SpinsCount" exact="0"/>
          </do_if>
          <set_value name="player.station.$casino_ledger.$VisitCount" operation="add"/>
        </do_if>

        <!-- Create 4-column Standalone Modal -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Create_Menu"
          param="table[
            $id             = 'x4_casino_lobby_menu',
            $columns        = 4,
            $title          = 'STATION CASINO &amp; GAMING LOBBY',
            $width          = 850,
            $onCloseElement = On_Menu_Closed,
          ]"/>
        <signal_cue_instantly cue="Build_Lobby_Menu"/>
      </actions>
    </cue>

    <!--
      Direct Modal Launcher: Open Slots Directly
    -->
    <cue name="Open_Slots_Direct" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Ensure player data table exists -->
        <do_if value="not player.entity.$casino_data?">
          <set_value name="player.entity.$casino_data" exact="table[]"/>
          <set_value name="player.entity.$casino_data.$CurrentBet" exact="5000"/>
          <set_value name="player.entity.$casino_data.$Reel1" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel2" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel3" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$ResultBanner" exact="'Select bet and press SPIN to play!'"/>
          <set_value name="player.entity.$casino_data.$TotalSpins" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWagered" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWon" exact="0"/>
          <set_value name="player.entity.$casino_data.$NetProfit" exact="0"/>
          <set_value name="player.entity.$casino_data.$JackpotsHit" exact="0"/>
          <set_value name="player.entity.$casino_data.$DemoMode" exact="0"/>
        </do_if>

        <!-- Track Station House Ledger if docked at a station -->
        <do_if value="player.station.exists">
          <do_if value="not player.station.$casino_ledger?">
            <set_value name="player.station.$casino_ledger" exact="table[]"/>
            <set_value name="player.station.$casino_ledger.$HouseGrossRevenue" exact="0"/>
            <set_value name="player.station.$casino_ledger.$HousePayoutsTotal" exact="0"/>
            <set_value name="player.station.$casino_ledger.$HouseNetIncome" exact="0"/>
            <set_value name="player.station.$casino_ledger.$VisitCount" exact="0"/>
            <set_value name="player.station.$casino_ledger.$SpinsCount" exact="0"/>
          </do_if>
          <set_value name="player.station.$casino_ledger.$VisitCount" operation="add"/>
        </do_if>

        <!-- Create 3-column Standalone Modal -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Create_Menu"
          param="table[
            $id             = 'x4_casino_slots_menu',
            $columns        = 3,
            $title          = 'TELADI PROFIT SPINNER',
            $width          = 780,
            $onCloseElement = On_Menu_Closed,
          ]"/>
        <signal_cue_instantly cue="Build_Slots_Menu"/>
      </actions>
    </cue>

    <!--
      Build the Casino Game Lobby UI Table
    -->
    <cue name="Build_Lobby_Menu" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$balanceCr" exact="player.money / 100"/>
        <set_value name="$data" exact="player.entity.$casino_data"/>

        <set_value name="$stationName" exact="'Station Casino Floor'"/>
        <do_if value="player.station.exists">
          <set_value name="$stationName" exact="player.station.name"/>
        </do_if>

        <!-- Row 1: Header / Location / Balance -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 4,
            $text = $stationName + '  |  Player Balance: ' + $balanceCr + ' Cr',
            $halign = 'center',
            $cellBGColor = 'Color.frame_background_semitransparent',
          ]"/>

        <!-- Row 2: Catalog Section Header -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 4,
            $text = 'AVAILABLE CASINO GAMES',
            $halign = 'left',
            $color = 'Color.chatuser_5',
          ]"/>

        <!-- Game 1: Teladi Profit Spinner (Active) -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $text = '[SLOTS] Teladi Profit Spinner',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 2,
            $text = '3-Reel Classic Fruit/Ore Slot (1k - 100k Cr)',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 3,
            $text = 'ACTIVE',
            $color = 'Color.chatuser_5',
            $halign = 'center',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 4,
            $id = 'btn_lobby_play_slots',
            $text = table[$text = '▶ PLAY NOW', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>

        <!-- Game 2: Space 21 Blackjack (Coming Soon) -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $text = '[CARDS] Space 21 Blackjack',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 2,
            $text = 'Single-Deck Dealer Blackjack Pays 3:2 (5k - 500k Cr)',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 3,
            $text = 'COMING SOON',
            $color = 'Color.text_inactive',
            $halign = 'center',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 4,
            $text = '(In Development)',
            $color = 'Color.text_inactive',
            $halign = 'center',
          ]"/>

        <!-- Game 3: Orbital Roulette (Coming Soon) -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $text = '[ROULETTE] Orbital Roulette',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 2,
            $text = 'European Single-Zero Wheel (2.5k - 1M Cr)',
            $halign = 'left',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 3,
            $text = 'COMING SOON',
            $color = 'Color.text_inactive',
            $halign = 'center',
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 4,
            $text = '(In Development)',
            $color = 'Color.text_inactive',
            $halign = 'center',
          ]"/>

        <!-- Lifetime Statistics Section -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 4,
            $text = 'PLAYER LIFETIME CASINO STATISTICS',
            $halign = 'left',
            $color = 'Color.chatuser_5',
          ]"/>
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 4,
            $text = 'Total Spins: ' + $data.$TotalSpins + '  |  Wagered: ' + $data.$TotalWagered + ' Cr  |  Won: ' + $data.$TotalWon + ' Cr  |  Net: ' + $data.$NetProfit + ' Cr  |  Jackpots: ' + $data.$JackpotsHit,
            $halign = 'center',
            $cellBGColor = 'Color.frame_background_semitransparent',
          ]"/>

        <!-- Station House Ledger Section (if player-owned station) -->
        <do_if value="player.station.exists and player.station.isplayerowned and player.station.$casino_ledger?">
          <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
          <signal_cue_instantly
            cue="md.Simple_Menu_API.Make_Text"
            param="table[
              $col = 1,
              $colSpan = 4,
              $text = 'STATION HOUSE LEDGER (OWNER)',
              $halign = 'left',
              $color = 'Color.chatuser_5',
            ]"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
          <signal_cue_instantly
            cue="md.Simple_Menu_API.Make_Text"
            param="table[
              $col = 1,
              $colSpan = 4,
              $text = 'Gross Revenue: ' + player.station.$casino_ledger.$HouseGrossRevenue + ' Cr  |  Payouts: ' + player.station.$casino_ledger.$HousePayoutsTotal + ' Cr  |  Net House Income: ' + player.station.$casino_ledger.$HouseNetIncome + ' Cr  |  Visits: ' + player.station.$casino_ledger.$VisitCount,
              $halign = 'center',
              $cellBGColor = 'Color.frame_background_semitransparent',
            ]"/>
        </do_if>

        <!-- Row: Close / Exit -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 1,
            $colSpan = 4,
            $id = 'btn_close_lobby',
            $text = table[$text = 'Close Lobby', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
      </actions>
    </cue>

    <!--
      Build the 2D Slot Machine UI Table
    -->
    <cue name="Build_Slots_Menu" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Ensure persistent state table exists on player -->
        <do_if value="not player.entity.$casino_data?">
          <set_value name="player.entity.$casino_data" exact="table[]"/>
          <set_value name="player.entity.$casino_data.$CurrentBet" exact="5000"/>
          <set_value name="player.entity.$casino_data.$Reel1" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel2" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$Reel3" exact="'[ --- ]'"/>
          <set_value name="player.entity.$casino_data.$ResultBanner" exact="'Select bet and press SPIN to play!'"/>
          <set_value name="player.entity.$casino_data.$TotalSpins" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWagered" exact="0"/>
          <set_value name="player.entity.$casino_data.$TotalWon" exact="0"/>
          <set_value name="player.entity.$casino_data.$NetProfit" exact="0"/>
          <set_value name="player.entity.$casino_data.$JackpotsHit" exact="0"/>
          <set_value name="player.entity.$casino_data.$DemoMode" exact="0"/>
        </do_if>

        <set_value name="$balanceCr" exact="player.money / 100"/>
        <set_value name="$data" exact="player.entity.$casino_data"/>

        <!-- Row 1: Header / Balance -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Add_Row"
          param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 3,
            $text = 'TELADI PROFIT SPINNER  |  Balance: ' + $balanceCr + ' Cr  |  Bet: ' + $data.$CurrentBet + ' Cr',
            $halign = 'center',
            $cellBGColor = 'Color.frame_background_semitransparent',
          ]"/>

        <!-- Row 2: Mode Banner / Solvency Notice -->
        <do_if value="$data.$DemoMode == 1">
          <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
          <signal_cue_instantly
            cue="md.Simple_Menu_API.Make_Text"
            param="table[
              $col = 1,
              $colSpan = 3,
              $text = '★ DEMO MODE / OWNER FREE-PLAY ACTIVE - No Credits Exchanged ★',
              $halign = 'center',
              $color = 'Color.chatuser_5',
            ]"/>
        </do_if>
        <do_elseif value="player.station.exists and player.station.isplayerowned">
          <set_value name="$stationTreasuryCr" exact="player.station.money / 100"/>
          <set_value name="$reqReserveCr" exact="$data.$CurrentBet * 50"/>
          <do_if value="$stationTreasuryCr lt $reqReserveCr">
            <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[$selectable = false]"/>
            <signal_cue_instantly
              cue="md.Simple_Menu_API.Make_Text"
              param="table[
                $col = 1,
                $colSpan = 3,
                $text = 'Station Treasury Low: ' + $stationTreasuryCr + ' Cr (Requires ' + $reqReserveCr + ' Cr reserve for max jackpot)',
                $halign = 'center',
                $color = 'Color.text_inactive',
              ]"/>
          </do_if>
        </do_elseif>

        <!-- Row 3: Owner Free-Play Toggle Button -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <do_if value="$data.$DemoMode == 1">
          <signal_cue_instantly
            cue="md.Simple_Menu_API.Make_Button"
            param="table[
              $col = 1,
              $colSpan = 3,
              $id = 'btn_toggle_demo',
              $text = table[$text = 'Free-Play Active (Click to Switch to Live Credits)', $halign = 'center'],
              $onClick = Handle_Casino_Action,
            ]"/>
        </do_if>
        <do_else>
          <signal_cue_instantly
            cue="md.Simple_Menu_API.Make_Button"
            param="table[
              $col = 1,
              $colSpan = 3,
              $id = 'btn_toggle_demo',
              $text = table[$text = 'Live Credits Mode (Click for Owner Free-Play / Demo Mode)', $halign = 'center'],
              $onClick = Handle_Casino_Action,
            ]"/>
        </do_else>

        <!-- Row 4: 3-Reel Display Boxes -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Add_Row"
          param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_BoxText"
          param="table[
            $col = 1,
            $id = 'box_reel1',
            $text = $data.$Reel1,
            $halign = 'center',
            $fontsize = 16,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_BoxText"
          param="table[
            $col = 2,
            $id = 'box_reel2',
            $text = $data.$Reel2,
            $halign = 'center',
            $fontsize = 16,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_BoxText"
          param="table[
            $col = 3,
            $id = 'box_reel3',
            $text = $data.$Reel3,
            $halign = 'center',
            $fontsize = 16,
          ]"/>

        <!-- Row 5: Result and Payout Message -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Add_Row"
          param="table[$selectable = false]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Text"
          param="table[
            $col = 1,
            $colSpan = 3,
            $id = 'txt_banner',
            $text = $data.$ResultBanner,
            $halign = 'center',
            $color = 'Color.chatuser_5',
            $cellBGColor = 'Color.frame_background_semitransparent',
          ]"/>

        <!-- Row 6: Bet Amount Buttons -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Add_Row"
          param="table[]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 1,
            $id = 'btn_bet_1000',
            $text = table[$text = 'Bet: 1,000 Cr', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 2,
            $id = 'btn_bet_5000',
            $text = table[$text = 'Bet: 5,000 Cr', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 3,
            $id = 'btn_bet_25000',
            $text = table[$text = 'Bet: 25,000 Cr', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>

        <!-- Row 7: High Roller, Spin, and Paytable -->
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Add_Row"
          param="table[]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 1,
            $id = 'btn_bet_100000',
            $text = table[$text = 'Bet: 100,000 Cr', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 2,
            $id = 'btn_spin',
            $text = table[
              $text   = '★ ★ ★  SPIN!  ★ ★ ★',
              $color  = 'Color.chatuser_5',
              $halign = 'center',
            ],
            $onClick = Handle_Casino_Action,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 3,
            $id = 'btn_payout_info',
            $text = table[$text = 'Paytable Info', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>

        <!-- Row 8: Navigation & Exit -->
        <signal_cue_instantly cue="md.Simple_Menu_API.Add_Row" param="table[]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 1,
            $colSpan = 2,
            $id = 'btn_go_lobby',
            $text = table[$text = '◀ Casino Game Lobby', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
        <signal_cue_instantly
          cue="md.Simple_Menu_API.Make_Button"
          param="table[
            $col = 3,
            $id = 'btn_close_slots',
            $text = table[$text = 'Close Machine', $halign = 'center'],
            $onClick = Handle_Casino_Action,
          ]"/>
      </actions>
    </cue>

    <!--
      Handle Button Clicks, Bet Switching, Demo Mode, and Spin Logic
    -->
    <cue name="Handle_Casino_Action" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="$data" exact="player.entity.$casino_data"/>

        <!-- Navigation: Go to Lobby -->
        <do_if value="event.param.$id == 'btn_go_lobby'">
          <signal_cue_instantly cue="Open_Lobby_Direct"/>
        </do_if>

        <!-- Navigation: Play Slots from Lobby -->
        <do_if value="event.param.$id == 'btn_lobby_play_slots'">
          <signal_cue_instantly cue="Open_Slots_Direct"/>
        </do_if>

        <!-- Navigation: Close Menus -->
        <do_if value="event.param.$id == 'btn_close_lobby' or event.param.$id == 'btn_close_slots'">
          <signal_cue_instantly cue="md.Simple_Menu_API.Close_Menu"/>
        </do_if>

        <!-- Toggle Demo Mode / Owner Free-Play -->
        <do_if value="event.param.$id == 'btn_toggle_demo'">
          <do_if value="$data.$DemoMode == 1">
            <set_value name="$data.$DemoMode" exact="0"/>
            <set_value name="$data.$ResultBanner" exact="'Demo mode disabled. Live Credits active.'"/>
          </do_if>
          <do_else>
            <set_value name="$data.$DemoMode" exact="1"/>
            <set_value name="$data.$ResultBanner" exact="'Owner Free-Play enabled. No credits deducted or won.'"/>
          </do_else>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- Bet 1,000 -->
        <do_if value="event.param.$id == 'btn_bet_1000'">
          <set_value name="$data.$CurrentBet" exact="1000"/>
          <set_value name="$data.$ResultBanner" exact="'Bet set to 1,000 Credits.'"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- Bet 5,000 -->
        <do_if value="event.param.$id == 'btn_bet_5000'">
          <set_value name="$data.$CurrentBet" exact="5000"/>
          <set_value name="$data.$ResultBanner" exact="'Bet set to 5,000 Credits.'"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- Bet 25,000 -->
        <do_if value="event.param.$id == 'btn_bet_25000'">
          <set_value name="$data.$CurrentBet" exact="25000"/>
          <set_value name="$data.$ResultBanner" exact="'Bet set to 25,000 Credits.'"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- Bet 100,000 -->
        <do_if value="event.param.$id == 'btn_bet_100000'">
          <set_value name="$data.$CurrentBet" exact="100000"/>
          <set_value name="$data.$ResultBanner" exact="'High Roller! Bet set to 100,000 Credits.'"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- Paytable Info -->
        <do_if value="event.param.$id == 'btn_payout_info'">
          <set_value name="$data.$ResultBanner" exact="'Paytable: 3x Profit (50x) | 3x Nividium (20x) | 3x Ore/Silicon (10x) | 3x Energy (5x) | 2x Match (2x)'"/>
          <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
        </do_if>

        <!-- SPIN BUTTON PRESSED -->
        <do_if value="event.param.$id == 'btn_spin'">
          <set_value name="$betCr" exact="$data.$CurrentBet"/>
          <set_value name="$betInternal" exact="$betCr * 100"/>
          <set_value name="$isDemo" exact="($data.$DemoMode == 1)"/>

          <do_if value="not $isDemo and player.money lt $betInternal">
            <set_value name="$data.$ResultBanner" exact="'Insufficient Credits for this bet!'"/>
            <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
          </do_if>
          <do_else>
            <!-- Deduct Bet from Player if not Demo Mode -->
            <do_if value="not $isDemo">
              <reward_player money="-$betInternal"/>
              <set_value name="$data.$TotalWagered" exact="$data.$TotalWagered + $betCr"/>

              <!-- If Player-Owned Station: Deposit bet into station trade account -->
              <do_if value="player.station.exists and player.station.isplayerowned">
                <reward_player object="player.station" money="$betInternal"/>
                <do_if value="player.station.$casino_ledger?">
                  <set_value name="player.station.$casino_ledger.$HouseGrossRevenue" exact="player.station.$casino_ledger.$HouseGrossRevenue + $betCr"/>
                </do_if>
              </do_if>
            </do_if>

            <set_value name="$data.$TotalSpins" operation="add"/>
            <do_if value="player.station.exists and player.station.$casino_ledger?">
              <set_value name="player.station.$casino_ledger.$SpinsCount" operation="add"/>
            </do_if>

            <!-- Spin Reel 1 -->
            <set_value name="$r1_roll" min="1" max="12"/>
            <do_if value="$r1_roll le 5">
              <set_value name="$data.$Reel1" exact="'[ E-CELLS ]'"/>
              <set_value name="$sym1" exact="'energy_cells'"/>
            </do_if>
            <do_elseif value="$r1_roll le 8">
              <set_value name="$data.$Reel1" exact="'[   ORE   ]'"/>
              <set_value name="$sym1" exact="'ore'"/>
            </do_elseif>
            <do_elseif value="$r1_roll le 10">
              <set_value name="$data.$Reel1" exact="'[ SILICON ]'"/>
              <set_value name="$sym1" exact="'silicon'"/>
            </do_elseif>
            <do_elseif value="$r1_roll == 11">
              <set_value name="$data.$Reel1" exact="'[ NIVIDIUM]'"/>
              <set_value name="$sym1" exact="'nividium'"/>
            </do_elseif>
            <do_else>
              <set_value name="$data.$Reel1" exact="'[ PROFIT! ]'"/>
              <set_value name="$sym1" exact="'teladi_profit'"/>
            </do_else>

            <!-- Spin Reel 2 -->
            <set_value name="$r2_roll" min="1" max="12"/>
            <do_if value="$r2_roll le 5">
              <set_value name="$data.$Reel2" exact="'[ E-CELLS ]'"/>
              <set_value name="$sym2" exact="'energy_cells'"/>
            </do_if>
            <do_elseif value="$r2_roll le 8">
              <set_value name="$data.$Reel2" exact="'[ SILICON ]'"/>
              <set_value name="$sym2" exact="'silicon'"/>
            </do_elseif>
            <do_elseif value="$r2_roll le 10">
              <set_value name="$data.$Reel2" exact="'[   ORE   ]'"/>
              <set_value name="$sym2" exact="'ore'"/>
            </do_elseif>
            <do_elseif value="$r2_roll == 11">
              <set_value name="$data.$Reel2" exact="'[ NIVIDIUM]'"/>
              <set_value name="$sym2" exact="'nividium'"/>
            </do_elseif>
            <do_else>
              <set_value name="$data.$Reel2" exact="'[ PROFIT! ]'"/>
              <set_value name="$sym2" exact="'teladi_profit'"/>
            </do_else>

            <!-- Spin Reel 3 -->
            <set_value name="$r3_roll" min="1" max="12"/>
            <do_if value="$r3_roll le 5">
              <set_value name="$data.$Reel3" exact="'[ E-CELLS ]'"/>
              <set_value name="$sym3" exact="'energy_cells'"/>
            </do_if>
            <do_elseif value="$r3_roll le 8">
              <set_value name="$data.$Reel3" exact="'[   ORE   ]'"/>
              <set_value name="$sym3" exact="'ore'"/>
            </do_elseif>
            <do_elseif value="$r3_roll le 10">
              <set_value name="$data.$Reel3" exact="'[ SILICON ]'"/>
              <set_value name="$sym3" exact="'silicon'"/>
            </do_elseif>
            <do_elseif value="$r3_roll == 11">
              <set_value name="$data.$Reel3" exact="'[ NIVIDIUM]'"/>
              <set_value name="$sym3" exact="'nividium'"/>
            </do_elseif>
            <do_else>
              <set_value name="$data.$Reel3" exact="'[ PROFIT! ]'"/>
              <set_value name="$sym3" exact="'teladi_profit'"/>
            </do_else>

            <!-- Evaluate Multipliers -->
            <set_value name="$multiplier" exact="0"/>
            <set_value name="$winTitle" exact="'No match. Teladi keeps profitsss!'"/>

            <do_if value="$sym1 == $sym2 and $sym2 == $sym3">
              <do_if value="$sym1 == 'teladi_profit'">
                <set_value name="$multiplier" exact="50"/>
                <set_value name="$winTitle" exact="'★ ★ ★ TELADI JACKPOT! (50x) ★ ★ ★'"/>
              </do_if>
              <do_elseif value="$sym1 == 'nividium'">
                <set_value name="$multiplier" exact="20"/>
                <set_value name="$winTitle" exact="'♦ ♦ ♦ MAJOR WIN! (20x) ♦ ♦ ♦'"/>
              </do_elseif>
              <do_elseif value="$sym1 == 'silicon' or $sym1 == 'ore'">
                <set_value name="$multiplier" exact="10"/>
                <set_value name="$winTitle" exact="'▲ ▲ MEDIUM WIN! (10x) ▲ ▲'"/>
              </do_elseif>
              <do_elseif value="$sym1 == 'energy_cells'">
                <set_value name="$multiplier" exact="5"/>
                <set_value name="$winTitle" exact="'⚡ ENERGY BOOST! (5x) ⚡'"/>
              </do_elseif>
            </do_if>
            <do_elseif value="$sym1 == $sym2 or $sym2 == $sym3 or $sym1 == $sym3">
              <set_value name="$multiplier" exact="2"/>
              <set_value name="$winTitle" exact="'✓ PAIR MATCH! (2x Payout)'"/>
            </do_elseif>

            <!-- Handle Payouts and Ledger -->
            <do_if value="$isDemo">
              <!-- Demo Mode / Free-Play Execution -->
              <do_if value="$multiplier gt 0">
                <set_value name="$simulatedPayout" exact="$betCr * $multiplier"/>
                <set_value name="$data.$ResultBanner" exact="'[DEMO] ' + $winTitle + ' Simulated Win: ' + $simulatedPayout + ' Cr'"/>
              </do_if>
              <do_else>
                <set_value name="$data.$ResultBanner" exact="'[DEMO] ' + $winTitle"/>
              </do_else>
            </do_if>
            <do_else>
              <!-- Live Credits Execution -->
              <do_if value="$multiplier gt 0">
                <set_value name="$payoutCr" exact="$betCr * $multiplier"/>
                <set_value name="$payoutInternal" exact="$payoutCr * 100"/>
                <set_value name="$actualPayoutCr" exact="$payoutCr"/>
                <set_value name="$isDrained" exact="false"/>

                <!-- If Player-Owned Station: Withdraw payout from station treasury with graceful drain -->
                <do_if value="player.station.exists and player.station.isplayerowned">
                  <do_if value="player.station.money ge $payoutInternal">
                    <reward_player object="player.station" money="-$payoutInternal"/>
                    <reward_player money="$payoutInternal"/>
                  </do_if>
                  <do_else>
                    <!-- Station treasury drained -->
                    <set_value name="$drainedInternal" exact="player.station.money"/>
                    <set_value name="$actualPayoutCr" exact="$drainedInternal / 100"/>
                    <reward_player object="player.station" money="-$drainedInternal"/>
                    <reward_player money="$drainedInternal"/>
                    <set_value name="$isDrained" exact="true"/>
                  </do_else>

                  <do_if value="player.station.$casino_ledger?">
                    <set_value name="player.station.$casino_ledger.$HousePayoutsTotal" exact="player.station.$casino_ledger.$HousePayoutsTotal + $actualPayoutCr"/>
                    <set_value name="player.station.$casino_ledger.$HouseNetIncome" exact="player.station.$casino_ledger.$HouseGrossRevenue - player.station.$casino_ledger.$HousePayoutsTotal"/>
                  </do_if>
                </do_if>
                <do_else>
                  <!-- NPC Station Payout -->
                  <reward_player money="$payoutInternal"/>
                  <do_if value="player.station.exists and player.station.$casino_ledger?">
                    <set_value name="player.station.$casino_ledger.$HousePayoutsTotal" exact="player.station.$casino_ledger.$HousePayoutsTotal + $payoutCr"/>
                    <set_value name="player.station.$casino_ledger.$HouseNetIncome" exact="player.station.$casino_ledger.$HouseGrossRevenue - player.station.$casino_ledger.$HousePayoutsTotal"/>
                  </do_if>
                </do_else>

                <!-- Update Player Lifetime Stats -->
                <set_value name="$data.$TotalWon" exact="$data.$TotalWon + $actualPayoutCr"/>
                <set_value name="$data.$NetProfit" exact="$data.$TotalWon - $data.$TotalWagered"/>
                <do_if value="$multiplier == 50">
                  <set_value name="$data.$JackpotsHit" operation="add"/>
                </do_if>

                <do_if value="$isDrained">
                  <set_value name="$data.$ResultBanner" exact="'★ JACKPOT! Station treasury drained: Received ' + $actualPayoutCr + ' Cr (Station at 0 Cr) ★'"/>
                </do_if>
                <do_else>
                  <set_value name="$data.$ResultBanner" exact="$winTitle + ' Won: ' + $actualPayoutCr + ' Cr!'"/>
                </do_else>
              </do_if>
              <do_else>
                <!-- Loss Round -->
                <set_value name="$data.$NetProfit" exact="$data.$TotalWon - $data.$TotalWagered"/>
                <do_if value="player.station.exists and player.station.$casino_ledger?">
                  <set_value name="player.station.$casino_ledger.$HouseNetIncome" exact="player.station.$casino_ledger.$HouseGrossRevenue - player.station.$casino_ledger.$HousePayoutsTotal"/>
                </do_if>
                <set_value name="$data.$ResultBanner" exact="$winTitle + ' Lost: ' + $betCr + ' Cr'"/>
              </do_else>
            </do_else>

            <!-- Refresh the menu with updated reels & credits -->
            <signal_cue_instantly cue="md.Simple_Menu_API.Refresh_Menu"/>
          </do_else>
        </do_if>
      </actions>
    </cue>

    <!--
      Clean Menu Closure Callback
    -->
    <cue name="On_Menu_Closed" instantiate="true" namespace="this">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <!-- Clean return to first-person view -->
      </actions>
    </cue>
  </cues>
</mdscript>
